# ================================================
# Invonaut ENVIRONMENT VARIABLES
# ================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git!
#
# How to get these values:
# - Supabase: https://app.supabase.com → Your Project → Settings → API
# - OpenAI: https://platform.openai.com/api-keys
# - Resend: https://resend.com/api-keys
# ================================================

# ================================================
# SUPABASE CONFIGURATION
# ================================================
# Get these from: Supabase Dashboard → Settings → API

# Public URL - Safe to expose in browser
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Anonymous Key - Safe to expose in browser (public access only)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key - KEEP SECRET! Never expose in browser
# Has full database access, bypasses RLS
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ================================================
# OPENAI CONFIGURATION
# ================================================
# Get this from: https://platform.openai.com/api-keys
# Used for AI payment predictions
# Cost: ~$0.002 per prediction (GPT-4o-mini)

# OpenAI API Key - KEEP SECRET!
# Example: sk-proj-abc123def456...
OPENAI_API_KEY=your_openai_api_key_here

# ================================================
# RESEND EMAIL CONFIGURATION
# ================================================
# Get this from: https://resend.com/api-keys
# Used for sending invoice emails and reminders
# Free tier: 3,000 emails/month, 100 emails/day

# Resend API Key - KEEP SECRET!
# Example: re_abc123def456...
RESEND_API_KEY=your_resend_api_key_here

# ================================================
# OPTIONAL: PRODUCTION OVERRIDES
# ================================================
# These are automatically set by Vercel in production
# Only set these if you need custom values

# Production URL (optional, auto-detected by Next.js)
# Example: https://Invonaut.com or https://Invonaut-mvp.vercel.app
# NEXT_PUBLIC_APP_URL=

# Node Environment (optional, auto-set by Vercel)
# Values: development | production | test
# NODE_ENV=

# ================================================
# NOTES
# ================================================
# 
# ENVIRONMENT-SPECIFIC CONFIGURATIONS:
# 
# Development (.env.local):
# - Use Supabase development project
# - Use test OpenAI key (if different)
# - Resend sends to verified emails only
# 
# Production (Vercel Environment Variables):
# - Use Supabase production project
# - Use production OpenAI key
# - Verify Resend domain for sending to any email
# 
# SECURITY BEST PRACTICES:
# - Never commit actual keys to Git
# - Rotate keys if accidentally exposed
# - Use different keys for dev/prod
# - Enable 2FA on all service accounts
# - Monitor API usage for anomalies
#
# GETTING HELP:
# - Supabase docs: https://supabase.com/docs
# - OpenAI docs: https://platform.openai.com/docs
# - Resend docs: https://resend.com/docs
# - Invonaut docs: See README.md
# ================================================